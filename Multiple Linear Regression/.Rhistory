do.call(plot, c(list(model, which = 2), style)); add_label(qq$x[idx], qq$y[idx])
do.call(plot, c(list(model, which = 3), style)); add_label(fitted(model)[idx], sqrt(abs(rstandard(model)))[idx])
do.call(plot, c(list(model, which = 5), style))
# 4c. Multicollinearity and normality tests
