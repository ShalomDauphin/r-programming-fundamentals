# ---------- 1. Load data ----------
load_data <- function() {
df <- datasets::mtcars
stopifnot(is.data.frame(df), nrow(df) > 0)
df
}
# ---------- 2. Fit model ----------
fit_model <- function(data, response = "mpg", predictors = c("wt", "hp")) {
stopifnot(is.data.frame(data),
is.character(response), length(response) == 1,
is.character(predictors), length(predictors) >= 2)
missing_cols <- setdiff(c(response, predictors), names(data))
if (length(missing_cols) > 0) {
stop("Column(s) not found in data: ", paste(missing_cols, collapse = ", "))
}
f <- as.formula(paste(response, "~", paste(predictors, collapse = " + ")))
lm(f, data = data)
}
# ---------- 3. Diagnostic plots ----------
# file = NULL draws on the current device (used when knitting);
# file = "name.png" also saves a large, high-resolution image.
plot_diagnostics <- function(model, file = NULL) {
stopifnot(inherits(model, "lm"))
idx   <- which.max(abs(rstandard(model)))      # most extreme point
name  <- names(rstandard(model))[idx]
qq    <- qqnorm(rstandard(model), plot.it = FALSE)
style <- list(pch = 19, col = "steelblue", cex = 1.4, id.n = 0)
# Label placed ABOVE the point so it does not collide with the dots
add_label <- function(x, y) {
text(x, y, labels = name, pos = 3, offset = 0.9,
cex = 1, font = 2, xpd = TRUE)
}
draw_all <- function() {
do.call(plot, c(list(model, which = 1), style))
add_label(fitted(model)[idx], resid(model)[idx])
do.call(plot, c(list(model, which = 2), style))
add_label(qq$x[idx], qq$y[idx])
do.call(plot, c(list(model, which = 3), style))
add_label(fitted(model)[idx], sqrt(abs(rstandard(model)))[idx])
do.call(plot, c(list(model, which = 5), style))
}
if (!is.null(file)) {
png(file, width = 2400, height = 2000, res = 250)
op <- par(mfrow = c(2, 2), mar = c(5, 5, 4, 2))
draw_all()
par(op)
dev.off()
} else {
op <- par(mfrow = c(2, 2), mar = c(5, 5, 4, 2))
draw_all()
par(op)
}
invisible(file)
}
# ---------- 4. Assumption tests ----------
run_tests <- function(model) {
stopifnot(inherits(model, "lm"))
if (!requireNamespace("car", quietly = TRUE)) {
stop("Package 'car' is needed. Install it with install.packages('car').")
}
list(
vif     = car::vif(model),
shapiro = shapiro.test(residuals(model))
)
}
mtcars_df <- load_data()
head(mtcars_df)
str(mtcars_df)
summary(mtcars_df[, c("mpg", "wt", "hp")])
cor(mtcars_df[, c("mpg", "wt", "hp")])
pairs(mtcars_df[, c("mpg", "wt", "hp")],
pch = 19, col = "steelblue", cex = 1.3, cex.labels = 2)
model <- fit_model(mtcars_df)
summary(model)
confint(model)
plot_diagnostics(model)
tests <- run_tests(model)
tests
test_all <- function() {
results <- list()
check <- function(label, expr) {
out <- tryCatch({ force(expr); "PASS" },
error   = function(e) paste("FAIL:", conditionMessage(e)),
warning = function(w) paste("WARN:", conditionMessage(w)))
results[[label]] <<- out
}
d <- load_data()
m <- fit_model(d)
# Normal use
check("load_data()",                 load_data())
check("fit_model() good input",      fit_model(d))
check("plot_diagnostics() good",     plot_diagnostics(m, tempfile(fileext = ".png")))
check("run_tests() good",            run_tests(m))
# Deliberately bad input
check("fit_model() bad column",      fit_model(d, predictors = c("weight", "hp")))
check("fit_model() one predictor",   fit_model(d, predictors = "wt"))
check("fit_model() not a data.frame", fit_model(as.matrix(d)))
check("plot_diagnostics() not lm",   plot_diagnostics("not a model"))
check("run_tests() not lm",          run_tests(42))
data.frame(test = names(results), result = unlist(results), row.names = NULL)
}
test_all()
tryCatch(
fit_model(mtcars_df, predictors = c("weight", "hp")),
error = function(e) {
cat("Error message:", conditionMessage(e), "\n")
cat("Raised in call:", deparse(conditionCall(e)), "\n")
}
)
fns <- c("load_data", "fit_model", "plot_diagnostics", "run_tests")
invisible(lapply(fns, debug))            # turn debugging ON
sapply(fns, isdebugged)                  # confirm
invisible(lapply(fns, undebug))          # turn debugging OFF
sapply(fns, isdebugged)                  # confirm it is off
trace("fit_model",
quote(cat("Fitting with predictors:", predictors, "\n")),
print = FALSE)
invisible(fit_model(mtcars_df))
untrace("fit_model")
sessionInfo()
summary_stats <- function(x) {
# Check that the input is numeric
if (!is.numeric(x)) {
stop("The input must be a numeric variable.")
}
# Remove missing values
x_clean <- x[!is.na(x)]
# Check that at least one valid observation exists
if (length(x_clean) == 0) {
stop("The variable contains no valid numeric observations.")
}
# Calculate summary statistics
results <- data.frame(
Statistic = c(
"Number of observations",
"Number of missing values",
"Mean",
"Median",
"Standard deviation",
"Variance",
"Minimum",
"Maximum",
"Range",
"First quartile (Q1)",
"Third quartile (Q3)"
),
Value = c(
length(x_clean),
sum(is.na(x)),
mean(x_clean),
median(x_clean),
sd(x_clean),
var(x_clean),
min(x_clean),
max(x_clean),
diff(range(x_clean)),
as.numeric(quantile(x_clean, 0.25)),
as.numeric(quantile(x_clean, 0.75))
)
)
return(results)
}
exam_scores <- c(65, 72, 80, 75, 90, 68, 85, 78, 92, NA)
# Display the variable
exam_scores
score_summary <- summary_stats(exam_scores)
# Display the results
score_summary
two_sample_t_test <- function(group1,
group2,
alternative = "two.sided",
var_equal = FALSE,
conf_level = 0.95) {
# Check that both groups are numeric
if (!is.numeric(group1) || !is.numeric(group2)) {
stop("Both groups must be numeric.")
}
# Remove missing values from each group
group1 <- group1[!is.na(group1)]
group2 <- group2[!is.na(group2)]
# Check that each group has at least two observations
if (length(group1) < 2 || length(group2) < 2) {
stop("Each group must contain at least two valid observations.")
}
# Perform the independent two-sample t-test
test_result <- t.test(
x = group1,
y = group2,
alternative = alternative,
var.equal = var_equal,
conf.level = conf_level
)
return(test_result)
}
method_A <- c(75, 80, 78, 85, 82, 77, 88, 79, 81, 84)
method_B <- c(68, 72, 70, 75, 73, 69, 76, 71, 74, 67)
# Display the two groups
method_A
method_B
t_test_results <- two_sample_t_test(
group1 = method_A,
group2 = method_B
)
# Display the complete t-test output
t_test_results
alpha <- 0.05
cat("Mean of Method A:", mean(method_A), "\n")
cat("Mean of Method B:", mean(method_B), "\n")
cat("t-statistic:", unname(t_test_results$statistic), "\n")
cat("Degrees of freedom:", unname(t_test_results$parameter), "\n")
cat("p-value:", t_test_results$p.value, "\n")
cat("95% confidence interval:",
t_test_results$conf.int[1], "to",
t_test_results$conf.int[2], "\n\n")
if (t_test_results$p.value < alpha) {
cat("Decision: Reject the null hypothesis.\n")
cat("Conclusion: There is a statistically significant difference",
"between the two group means.\n")
} else {
cat("Decision: Do not reject the null hypothesis.\n")
cat("Conclusion: There is insufficient evidence of a statistically",
"significant difference between the two group means.\n")
}
