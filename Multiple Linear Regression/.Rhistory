# Helper so every plot gets the same styling
style <- list(pch = 19, col = "steelblue", cex = 1.4, id.n = 0)
# Label helper: puts the name ABOVE the point, outside the dots
add_label <- function(x, y) {
text(x, y, labels = name, pos = 3, offset = 0.9, cex = 1, font = 2, xpd = TRUE)
}
